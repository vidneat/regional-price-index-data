          },
          {
            "name": "spot_usd",
            "type": "number",
            "description": "local_price / fx_rate"
          },
          {
            "name": "landed_usd",
            "type": "number",
            "description": "spot_usd × (1 + observed reseller premium) on gift-card routes with an observed listing; otherwise spot_usd. No tax added"
          },
          {
            "name": "savings_vs_us",
            "type": "number",
            "description": "1 − landed_usd / lowest US list price (same plan and cycle)"
          },
          {
            "name": "spread_vs_us",
            "type": "number",
            "description": "spot_usd / lowest US list price − 1"
          },
          {
            "name": "work_hours",
            "type": "number",
            "description": "Hours of GNI per capita per month of use (or per purchase): spot / (GNI per capita / 2000)"
          },
          {
            "name": "ppp_intl_usd",
            "type": "number",
            "description": "Local price per month of use (or per purchase) ÷ IMF implied PPP conversion rate"
          },
          {
            "name": "payment_route",
            "type": "string",
            "description": "gift_card (official gift cards; Steam: resold wallet codes) | store_payment (no gift cards) | web_checkout (vendor checkout)"
          },
          {
            "name": "verification_tier",
            "type": "string",
            "description": "purchase_tested | checkout_checked | source_verified | observed"
          },
          {
            "name": "is_best_channel",
            "type": "boolean",
            "description": "Cheapest landed channel for this plan in this storefront"
          },
          {
            "name": "observed_at",
            "type": "date",
            "description": "Date the price was observed"
          },
          {
            "name": "source_url",
            "type": "string",
            "description": "Where the price was read"
          }
